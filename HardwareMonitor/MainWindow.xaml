<Window x:Class="HardwareMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HardwareMonitor"
        Title="System Inspector" Height="750" Width="1000"
        Background="#1a1a2e" Foreground="#e0e0e0"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:AppViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#aaa"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="#16213e"
                                CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}"
                                Margin="2,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0f3460"/>
                                <Setter Property="Foreground" Value="#00d2ff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Верхняя панель ═══ -->
        <Border Grid.Row="0" Background="#16213e" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="SYSTEM INSPECTOR" FontSize="20" FontWeight="Bold"
                           Foreground="#00d2ff" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Обновить" Background="#0f3460"
                            Style="{StaticResource DarkBtn}" Command="{Binding CmdRefresh}"/>
                    <Button Content="Отчёт" Background="#1a5276" Margin="8,0,0,0"
                            Style="{StaticResource DarkBtn}" Command="{Binding CmdSaveReport}"/>
                    <Button Content="График" Background="#1a5276" Margin="8,0,0,0"
                            Style="{StaticResource DarkBtn}" Command="{Binding CmdSaveGraph}"/>
                    <Button Content="?" Background="#533483" Margin="8,0,0,0"
                            Width="40" Style="{StaticResource DarkBtn}" Click="HelpButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Вкладки ═══ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ────── Обзор ────── -->
            <TabItem Header="Обзор">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- OS -->
                        <Border Background="#16213e" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ОПЕРАЦИОННАЯ СИСТЕМА" FontSize="15"
                                           FontWeight="Bold" Foreground="#00d2ff" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Система:" Foreground="#888"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Os.SystemName, Mode=OneWay}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Сборка:" Foreground="#888"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Os.Build, Mode=OneWay}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Разрядность:" Foreground="#888"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Os.Bitness, Mode=OneWay}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Компьютер:" Foreground="#888"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Os.MachineName, Mode=OneWay}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Пользователь:" Foreground="#888"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Os.Account, Mode=OneWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CPU кратко -->
                        <Border Background="#16213e" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ПРОЦЕССОР" FontSize="15" FontWeight="Bold"
                                           Foreground="#00d2ff" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Cpu.ProcessorName, Mode=OneWay}" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Нагрузка: " Foreground="#888"/>
                                    <TextBlock Text="{Binding Cpu.LoadText, Mode=OneWay}" FontWeight="Bold"
                                               FontSize="16" Foreground="#55FF55"/>
                                </StackPanel>
                                <ProgressBar Height="12" Maximum="100"
                                             Value="{Binding Cpu.CurrentLoad, Mode=OneWay}"
                                             Foreground="#00d2ff" Background="#2a2a4a" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM кратко -->
                        <Border Background="#16213e" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="ПАМЯТЬ" FontSize="15" FontWeight="Bold"
                                           Foreground="#00d2ff" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Использовано: " Foreground="#888"/>
                                    <TextBlock Text="{Binding Ram.UsedPercentText, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="16" Foreground="#FFB347"/>
                                </StackPanel>
                                <ProgressBar Height="12" Maximum="100"
                                             Value="{Binding Ram.UsedPercent, Mode=OneWay}"
                                             Foreground="#FFB347" Background="#2a2a4a" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ────── CPU ────── -->
            <TabItem Header="CPU">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <Border Background="#16213e" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ЗАГРУЗКА CPU" FontSize="15" FontWeight="Bold"
                                           Foreground="#00d2ff" Margin="0,0,0,10"/>
                                <ProgressBar Height="22" Maximum="100"
                                             Value="{Binding Cpu.CurrentLoad, Mode=OneWay}"
                                             Foreground="#00d2ff" Background="#2a2a4a"/>
                                <TextBlock Text="{Binding Cpu.LoadText, Mode=OneWay}"
                                           FontSize="14" Margin="0,6,0,0" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#16213e" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ГРАФИК НАГРУЗКИ" FontSize="15" FontWeight="Bold"
                                           Foreground="#00d2ff" Margin="0,0,0,8"/>
                                <Border Background="#0d1117" CornerRadius="6" Height="180" Padding="4">
                                    <Canvas Name="GraphArea"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#16213e" CornerRadius="10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Модель:" Foreground="#888"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Cpu.ProcessorName, Mode=OneWay}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Вендор:" Foreground="#888"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cpu.Vendor, Mode=OneWay}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Платформа:" Foreground="#888"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Cpu.PlatformType, Mode=OneWay}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Физических ядер:" Foreground="#888"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Cpu.PhysicalCores, Mode=OneWay}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Логических потоков:" Foreground="#888"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Cpu.LogicalCores, Mode=OneWay}"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Частота:" Foreground="#888"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Cpu.FrequencyGHz, Mode=OneWay}"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ────── RAM ────── -->
            <TabItem Header="RAM">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <Border Background="#16213e" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ИСПОЛЬЗОВАНИЕ ПАМЯТИ" FontSize="15"
                                           FontWeight="Bold" Foreground="#00d2ff" Margin="0,0,0,10"/>

                                <ProgressBar Height="22" Maximum="100"
                                             Value="{Binding Ram.UsedPercent, Mode=OneWay}"
                                             Foreground="#FFB347" Background="#2a2a4a"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Занято: " Foreground="#888"/>
                                    <TextBlock Text="{Binding Ram.UsedPercentText, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="16" Foreground="#FFB347"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#16213e" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Всего: " Foreground="#888" Width="120"/>
                                    <TextBlock Text="{Binding Ram.TotalMBText, Mode=OneWay}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Свободно: " Foreground="#888" Width="120"/>
                                    <TextBlock Text="{Binding Ram.FreeMBText, Mode=OneWay}" FontWeight="Bold"
                                               Foreground="#55FF55"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Использовано: " Foreground="#888" Width="120"/>
                                    <TextBlock Text="{Binding Ram.UsedMBText, Mode=OneWay}" FontWeight="Bold"
                                               Foreground="#FF6B6B"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Модулей: " Foreground="#888" Width="120"/>
                                    <TextBlock Text="{Binding Ram.Sticks.Count, Mode=OneWay}" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#16213e" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="УСТАНОВЛЕННЫЕ МОДУЛИ" FontSize="14"
                                           FontWeight="Bold" Foreground="#00d2ff" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Ram.Sticks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0f3460" CornerRadius="6"
                                                    Padding="10" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Brand}" Width="150"/>
                                                    <TextBlock Text="{Binding SizeText}" Width="100"
                                                               Foreground="#55FF55"/>
                                                    <TextBlock Text="{Binding FreqText}"
                                                               Foreground="#FFB347"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ────── Диски ────── -->
            <TabItem Header="Диски">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <Border Background="#16213e" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ФИЗИЧЕСКИЕ НАКОПИТЕЛИ" FontSize="15"
                                           FontWeight="Bold" Foreground="#00d2ff" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Storage.Drives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0f3460" CornerRadius="6"
                                                    Padding="10" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ModelName}" Width="300"/>
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#55FF55"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="#16213e" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="РАЗДЕЛЫ" FontSize="15" FontWeight="Bold"
                                           Foreground="#00d2ff" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Storage.Partitions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0f3460" CornerRadius="6"
                                                    Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Letter}" FontSize="16"
                                                                   FontWeight="Bold" Foreground="#00d2ff" Width="50"/>
                                                        <TextBlock Text="{Binding FsType}" Foreground="#888"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ProgressBar Height="10" Maximum="100"
                                                                 Value="{Binding OccupiedPercent, Mode=OneWay}"
                                                                 Foreground="#e94560" Background="#2a2a4a"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Foreground="#888">
                                                            <Run Text="Всего: "/>
                                                            <Run Text="{Binding CapacityBytes,
                                                                 Converter={StaticResource ToGB}, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Foreground="#888" Margin="20,0,0,0">
                                                            <Run Text="Свободно: "/>
                                                            <Run Text="{Binding FreeBytes,
                                                                 Converter={StaticResource ToGB}, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Margin="20,0,0,0" FontWeight="Bold">
                                                            <Run Text="Занято: "/>
                                                            <Run Text="{Binding OccupiedPercent,
                                                                 StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ────── Задачи ────── -->
            <TabItem Header="Задачи">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding ChosenTask}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#16213e"
                              Foreground="#e0e0e0"
                              RowBackground="#16213e"
                              AlternatingRowBackground="#1a2744"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2a2a4a"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              FontSize="13">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0f3460"/>
                                <Setter Property="Foreground" Value="#00d2ff"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTextColumn Header="Процесс" Binding="{Binding ProcessName}" Width="220"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding State}" Width="100"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" Width="80"/>
                            <DataGridTextColumn Header="RAM (МБ)" Binding="{Binding RamMB, StringFormat={}{0:F1}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Завершить процесс" Background="#e94560"
                                Style="{StaticResource DarkBtn}"
                                Command="{Binding CmdEndTask}"/>
                        <TextBlock Text="  (или дважды кликните по строке)"
                                   Foreground="#666" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ Статус-бар ═══ -->
        <Border Grid.Row="2" Background="#16213e" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="#888" FontSize="12"/>
        </Border>

    </Grid>
</Window>